# Скопируйте в .env перед запуском: cp .env.example .env
# Значения ниже — локальные заглушки, не реальные секреты.

PORT=3000
DB_PATH=./data/secret-santa.sqlite

# Домен приложения и поддоменов.
DOMAIN=santa.local
DOMAIN_NAME=santa.local

# Локальный bootstrap. Для production замените на публичный URL.
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
VITE_API_BASE_URL=/api
VITE_DOMAIN=santa.local

TRUST_PROXY=true

# Лимит запросов /api/auth в минуту: по умолчанию 20; в browser E2E временно 200.
# AUTH_RATE_LIMIT_MAX=20

# Caddy: internal — самоподписанный TLS для разработки; wildcard требует Cloudflare.
CADDYFILE=Caddyfile.internal
CLOUDFLARE_API_TOKEN=
# TRUSTED_PROXIES=

# Бэкапы: OFFSITE_BACKUP_COMMAND выполняется через sh -c, BACKUP_FILE содержит путь к копии.
BACKUP_DIR=./data/backups
BACKUP_RETENTION=14
BACKUP_INTERVAL_SECONDS=86400
OFFSITE_BACKUP_COMMAND=

# Мониторинг: токен не логируется; webhook получает JSON только с адресами и статусами.
MONITORING_ENABLED=false
MONITORING_INTERVAL_MS=60000
MONITORING_TIMEOUT_MS=5000
MONITORING_CONCURRENCY=4
MONITORING_KEEP_CHECKS=500
MONITORING_KEEP_ERRORS=200
MONITORING_TOKEN=
MONITORING_WEBHOOK_URL=

# Только для стейджа: разрешить localhost в APP_URL при NODE_ENV=production.
ALLOW_LOCAL_APP_URL=false

# Не используется кодом приложения, оставлено как памятка о внешних шагах:
# SESSION_SECRET=
# MAIL_FROM=
# TLS_EMAIL=
